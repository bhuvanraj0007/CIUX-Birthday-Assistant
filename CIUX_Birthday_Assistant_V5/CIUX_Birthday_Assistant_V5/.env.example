# ===================================================
# CIUX Birthday Assistant - Version 5 Environment Configuration
# ===================================================

# Flask Secret Key for Session Encryption
SECRET_KEY=ciux_birthday_assistant_v5_secret_key_change_in_production
FLASK_DEBUG=True

# OpenAI API Settings (Optional)
# If left blank, the chatbot automatically falls back to rule-based NLU without crashing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Service Settings
UPCOMING_DAYS=30

# Server Settings
FLASK_HOST=127.0.0.1
FLASK_PORT=5005
